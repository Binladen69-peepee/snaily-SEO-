# Database — Vercel runtime must use the Supabase *transaction pooler* (IPv4).
# Do not point DATABASE_URL at db.YOUR_PROJECT_REF.supabase.co:5432; that direct
# host is IPv6-only and Vercel cannot reach it.
#
# Username is postgres.YOUR_PROJECT_REF (not postgres).
# Encode @ in the password as %40.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Session pooler for Prisma migrate / db push only (not app queries).
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Auth (long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Google OAuth (Search Console + GA4)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback


# A real client id and secret used to sit here, commented out. This file is
# committed, so anything written in it is public to anyone with the repo -
# credentials belong in .env.local, which is gitignored.
