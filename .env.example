# Database (Supabase Postgres — encode @ in password as %40)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&connect_timeout=30

# Auth (long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Google OAuth (Search Console + GA4)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Keyword research SERP providers (both kept)
# Primary: DataForSEO. Fallback: SerpApi when DataForSEO is missing/fails.
# Authority/backlinks → DataForSEO
# SERPAPI_KEY=
# Force sample data only: KEYWORD_PROVIDER=mock
# KEYWORD_PROVIDER=

# DataForSEO — SERP backup + domain Rank / backlinks (server-side only).
# Never commit real credentials. Rank is not Moz DA/PA.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# AI writing for Content Assistant + GEO Lab (Groq gsk_… or xAI xai-…)
# GROK_API_KEY=
# GROQ_API_KEY=
# GROK_MODEL=
# GROQ_MODEL=

# Drafter generation limits. Defaults suit Groq's on-demand openai/gpt-oss-120b,
# which meters prompt + reply together at 8,000 tokens per minute. Raise
# AI_TPM_BUDGET to match a larger plan; the pipeline paces itself to whatever it
# is told and will simply finish an article faster.
# AI_TPM_BUDGET=7600
# AI_MAX_OUTPUT_TOKENS=3000
# AI_RETRY_LIMIT=3
# AI_STAGE_TIMEOUT=50000

# Reasoning models (gpt-oss, deepseek-r1, qwen3) spend part of the reply budget
# thinking before they write. "low" is the default and produced longer, better
# formed sections here than the provider's own default. "off" omits the
# parameter entirely, for a model that rejects it.
# AI_REASONING_EFFORT=low
# AI_REASONING_RESERVE=300

# Background draft jobs. CRON_SECRET authorises /api/cron/draft-jobs, which
# picks up generations whose worker died with nobody watching; without it that
# endpoint refuses every request. Vercel sets it as a bearer token automatically
# once the value exists in the project's environment variables.
#
# The schedule in vercel.json is daily because Hobby allows nothing more
# frequent. On Pro, change it to "*/5 * * * *".
# CRON_SECRET=

# How the deployment reaches itself to hand a job to the next worker.
#
# Normally unnecessary: the host a request arrived on is used, which is the
# public alias. Set it only if jobs stall at "queued" — that means the loopback
# call is not landing, and a hard-coded public origin settles it. Never point it
# at a *-hash-team.vercel.app deployment URL: on a protected project those
# redirect to an SSO login and every handoff is quietly lost.
# NEXT_PUBLIC_APP_URL=https://cinnamon-snail-seo-tool.vercel.app

# Site audit crawler — off by default; set to 1 only for local/staging
# ALLOW_PRIVATE_CRAWL=1

# Force keyword provider: mock | serpapi
# KEYWORD_PROVIDER=mock
