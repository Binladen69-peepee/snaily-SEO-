# Database (Supabase Postgres — encode @ in password as %40)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&connect_timeout=30

# Auth (long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Google OAuth (Search Console + GA4)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback


# A real client id and secret used to sit here, commented out. This file is
# committed, so anything written in it is public to anyone with the repo -
# credentials belong in .env.local, which is gitignored.
