generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// "owner" can manage users; "member" is a VA-style account.
  role         String   @default("member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects      Project[]
  keywordLists  KeywordList[]
  searchHistory SearchHistory[]
  audits        Audit[]
  googleAccount GoogleAccount?
  articles      Article[]
  foresight     ForesightForecast[]
  tracked       TrackedKeyword[]
  geoIdeas      GeoIdea[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Google properties linked to this project, chosen once from the signed-in
  /// Google account. Null until the owner picks one.
  gscSiteUrl      String?
  gscSiteName     String?
  ga4PropertyId   String?
  ga4PropertyName String?
  gscSyncedAt     DateTime?
  ga4SyncedAt     DateTime?
  googleSyncError String?

  /// Set when the setup wizard is finished. Null sends the owner back into it.
  onboardedAt DateTime?

  /// Google Drive folder Drafter exports land in. Empty = create "Snaily SEO Drafts".
  driveFolderId String @default("")

  /// Owner opted out of WordPress setup reminders in project settings.
  wpReminderMuted Boolean @default(false)

  /// WordPress post ID of the reusable blog post template Drafter duplicates.
  /// Null falls back to auto-detection by title and section match.
  wpTemplatePostId Int?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits        Audit[]
  auditPages    AuditPage[]
  keywordLists  KeywordList[]
  articles      Article[]
  gscPages      GscPageMetric[]
  gscQueries    GscQueryMetric[]
  gscCountries  GscCountryMetric[]
  gscCountryKws GscCountryKeyword[]
  affiliates    AffiliateLink[]
  tracked       TrackedKeyword[]
  businessFacts BusinessFacts?
  geoIdeas      GeoIdea[]
  ga4Pages      Ga4PageMetric[]
  wordpress     WordPressConnection?
  wpPosts       WpPost[]
  wpTerms       WpTerm[]
  foresight     ForesightForecast[]

  @@unique([userId, url])
  @@index([userId])
}

/// Credentials for the Snaily SEO Connector plugin installed on a WordPress site.
///
/// The token is generated by the plugin, not by us — the site owner installs the
/// plugin, copies the token out of their own admin, and pastes it here. That way
/// no WordPress password is ever shared, and revoking access is a plugin
/// deactivation rather than a credential rotation.
model WordPressConnection {
  id           String    @id @default(cuid())
  projectId    String    @unique
  /// Origin the plugin answers on, e.g. "https://cinnamonsnail.com".
  siteUrl      String
  /// AES-256-GCM, same scheme as Google tokens. Never returned to the browser.
  token        String
  /// yoast | rankmath | aioseo | none — detected when the token is verified.
  seoPlugin    String    @default("none")
  wpVersion    String    @default("")
  siteName     String    @default("")
  /// Last failure talking to the plugin, shown in the UI so a dead
  /// connection does not look like an empty site.
  lastError    String?
  lastSyncedAt DateTime?
  /// Last live ping of the plugin. Null until the first verify/sync/export.
  healthCheckedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// One post or page pulled from WordPress.
///
/// Stored rather than fetched per page view: Content Intelligence joins this
/// against Search Console metrics, and a live call per row would be unusable.
model WpPost {
  id             String    @id @default(cuid())
  projectId      String
  /// The WordPress post ID — stable across title and slug changes.
  wpId           Int
  type           String    @default("post")
  status         String    @default("publish")
  title          String
  slug           String    @default("")
  link           String    @default("")
  excerpt        String    @default("")
  content        String    @default("")
  wordCount      Int       @default(0)
  categories     String[]  @default([])
  tags           String[]  @default([])
  author         String    @default("")
  /// Title/description as the site's SEO plugin has them, not as rendered.
  seoTitle       String    @default("")
  seoDescription String    @default("")
  /// Yoast linkdex or Rank Math score. Null when no SEO plugin is active.
  seoScore       Int?
  focusKeyword   String    @default("")
  publishedAt    DateTime?
  modifiedAt     DateTime?
  syncedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, wpId])
  @@index([projectId, modifiedAt])
}

/// A category or tag archive on the connected site, with its real permalink.
///
/// The "why you'll adore this recipe" section links to a group of recipes
/// rather than to one - "like all of my vegan Thai recipes" - and a category
/// archive is the page that group lives on. Only posts and pages were synced,
/// so there was no verified URL for one and the rule against inventing a URL
/// meant those links simply could not be written.
model WpTerm {
  id        String   @id @default(cuid())
  projectId String
  /// The WordPress term ID.
  wpId      Int
  taxonomy  String   @default("category")
  name      String
  slug      String   @default("")
  /// The archive permalink, exactly as WordPress reports it.
  link      String   @default("")
  /// Published posts in this term, used to skip near-empty archives.
  count     Int      @default(0)
  syncedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, taxonomy, wpId])
  @@index([projectId, taxonomy])
}

/// Cached authority signals for one domain, shared across every project.
///
/// Deployment-wide rather than per-project: the link-graph rank of
/// allrecipes.com is the same fact for everyone, and OpenPageRank's free
/// allowance is counted in domains, so re-fetching per project would burn it
/// for nothing. Refreshed monthly, which matches how often the underlying
/// Common Crawl graph is rebuilt.
model DomainMetric {
  id     String @id @default(cuid())
  domain String @unique

  /// OpenPageRank 0–10 from the Common Crawl link graph. Null = not in graph.
  openPageRank    Float?
  openPageRankPos Int?
  /// Years since registration, via RDAP. Null when the registry redacts it.
  domainAgeYears  Float?

  /// The computed Snaily scores, stored so a SERP render is one query.
  snailyDa    Int?
  snailyTrust Int?

  /// Referring domains from the Common Crawl graph, via CrawlGraph,
  /// or from DataForSEO backlinks/summary when that provider supplied them.
  /// Null = never looked up.
  referringDomains  Int?
  /// Top linking domains: [{ domain, hosts, authority }].
  linkingDomains    Json     @default("[]")
  /// Which quarterly crawl / provider the counts came from.
  linkDataRelease   String   @default("")
  /// Doubles as the monthly budget counter — one row per call spent.
  linkDataFetchedAt DateTime?

  /// DataForSEO Rank 0–100 (backlinks/bulk_ranks). Not Moz DA.
  dataforseoRank            Int?
  /// Backlink count from DataForSEO summary when fetched.
  dataforseoBacklinks       Int?
  /// Referring pages from DataForSEO summary when fetched.
  dataforseoReferringPages  Int?
  /// When DataForSEO rank/summary was last written. Auth failures are not cached long.
  dataforseoFetchedAt       DateTime?
  /// DataForSEO backlinks spam score 0–100 when fetched.
  dataforseoSpamScore       Int?

  /// Which signals were actually present, so the UI can show confidence.
  signalsUsed String[] @default([])

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fetchedAt])
  @@index([dataforseoFetchedAt])
}

/// Page-level DataForSEO metrics for Keyword Research SERP rows.
model PageMetric {
  id  String @id @default(cuid())
  url String @unique

  dataforseoRank             Int?
  dataforseoBacklinks        Int?
  dataforseoReferringDomains Int?
  dataforseoSpamScore        Int?
  dataforseoMainDomainRank   Int?
  dataforseoFetchedAt        DateTime?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dataforseoFetchedAt])
}

/// Record of an owner signing in as another account.
///
/// Impersonation is a real access grant, so it leaves a trail that the person
/// using it cannot edit from the UI. Written when the session starts and
/// stamped again when it is handed back, so an open-ended row means someone
/// closed the tab rather than returning to their own account.
model ImpersonationLog {
  id String @id @default(cuid())

  /// The owner who initiated it.
  actorId    String
  actorEmail String
  /// The account they signed in as.
  targetId    String
  targetEmail String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([actorId, startedAt])
  @@index([targetId])
}

/// Cached third-party SERP/autocomplete responses.
/// The free SerpApi tier is 250 searches a month, so every call is cached and
/// reused until it expires rather than being re-fetched per page view.
model SerpCache {
  id        String   @id @default(cuid())
  /// e.g. "google" | "google_autocomplete"
  engine    String
  query     String
  country   String   @default("us")
  payload   Json
  fetchedAt DateTime @default(now())

  @@unique([engine, query, country])
  @@index([fetchedAt])
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  keyword     String
  country     String   @default("us")
  resultCount Int      @default(0)
  searchCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword, country])
  @@index([userId])
}

model KeywordList {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  name      String
  country   String   @default("us")
  /// Embedded keyword entries (same shape as the former Mongoose subdocs).
  keywords  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([userId])
  @@index([projectId])
}

model Audit {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  status       String    @default("running")
  startUrl     String
  maxPages     Int       @default(100)
  pagesCrawled Int       @default(0)
  pagesFound   Int       @default(0)
  healthScore  Int       @default(0)
  /// Record<IssueCode, number>
  issueCounts  Json      @default("{}")
  totalIssues  Int       @default(0)
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   AuditPage[]

  @@index([userId])
  @@index([projectId])
  @@index([projectId, createdAt])
}

model AuditPage {
  id                String    @id @default(cuid())
  auditId           String
  projectId         String
  url               String
  path              String    @default("/")
  status            Int       @default(0)
  title             String    @default("")
  metaDescription   String    @default("")
  h1                String[]  @default([])
  wordCount         Int       @default(0)
  canonical         String    @default("")
  indexable         Boolean   @default(true)
  lastModified      DateTime?
  /// Content images only — chrome and decorative images excluded.
  imagesTotal       Int       @default(0)
  /// Content images with no alt attribute at all.
  imagesMissingAlt  Int       @default(0)
  /// The src of each image missing alt, so a fix can name its target.
  imagesMissingAltSrc String[] @default([])
  /// Images correctly marked decorative (alt="", role=presentation, aria-hidden).
  imagesDecorative  Int       @default(0)
  /// Images belonging to site chrome rather than this page's content.
  imagesChrome      Int       @default(0)
  internalLinkCount Int       @default(0)
  /// Destinations genuinely gone (404/410/5xx after retry).
  brokenLinks       String[]  @default([])
  /// Destinations the host refused to serve the crawler, or that timed out.
  blockedLinks      String[]  @default([])
  /// Issue[]
  issues            Json      @default("[]")
  /// Denormalized codes from `issues` for efficient filtering (replaces Mongo path query).
  issueCodes        String[]  @default([])
  issueScore        Int       @default(0)

  audit   Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([auditId, url])
  @@index([auditId])
  @@index([auditId, issueScore])
  @@index([projectId])
}

/// Search Console performance per URL — what Content Intelligence ranks pages on.
model GscPageMetric {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @db.Date
  page        String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, page])
  @@index([projectId, date])
}

/// Search Console performance per query — powers keyword insights.
model GscQueryMetric {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @db.Date
  query       String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, query])
  @@index([projectId, date])
}

/// One day's reading of a domain's link profile.
///
/// The Backlinks Overview chart is a twelve-month trend, and a trend needs
/// history. Nothing free publishes a backlink time series, and the Common
/// Crawl graph reports only the current release — so the history is built the
/// way a real provider builds one: by writing down today's figure every time a
/// domain is looked at, and letting the curve accrue. One row per domain per
/// day; re-analysing the same domain twice in a day overwrites rather than
/// spikes the chart.
model DomainLinkSnapshot {
  id     String   @id @default(cuid())
  domain String
  day    DateTime @db.Date

  backlinks        Int?
  referringDomains Int?
  /// Snaily DA on the day, so the chart can show strength alongside links.
  authority        Int?

  createdAt DateTime @default(now())

  @@unique([domain, day])
  @@index([domain, day])
}

/// One ingredient or product, and the URL to link it to.
///
/// Imported from the author's own spreadsheet. `kind` matters for SEO: an
/// affiliate link must carry rel="sponsored nofollow" or it risks a manual
/// action, while a link to the site's own recipe must not, because those rel
/// values throw away the internal link equity that makes it worth having.
model AffiliateLink {
  id        String @id @default(cuid())
  projectId String
  /// Lowercased, whitespace-collapsed ingredient name — the match key.
  term     String
  /// Word count of `term`, denormalised so the matcher can sort longest-first
  /// without recomputing it for 500 rows on every draft.
  words    Int    @default(1)
  category String @default("")
  url      String
  /// affiliate | internal
  kind     String @default("affiliate")
  /// Off by default for bare generics ("salt", "oil") that would over-link.
  enabled  Boolean @default(true)
  /// wordpress | csv — where this row came from, so a WordPress refresh can
  /// replace its own rows without touching anything imported by hand.
  source   String  @default("csv")
  /// The Easy Affiliate Links post id, when the row came from WordPress.
  sourceId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term])
  @@index([projectId, enabled])
}

/// Search Console clicks per country — powers the Traffic by Country panel.
///
/// Same date grain as the page and query tables, so the range toggle on the
/// domain overview filters all three consistently.
model GscCountryMetric {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @db.Date
  /// ISO-3166-1 alpha-3, lowercase, exactly as Search Console reports it.
  country     String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, country])
  @@index([projectId, date])
}

/// Distinct Search Console queries per country.
///
/// Kept separate from GscCountryMetric because it has no date grain: asking
/// Search Console for date × country × query blows past the row limit on any
/// real site, and summing per-day distinct counts would count one keyword
/// once per day it ranked. This is a whole-window figure, and the UI labels it
/// as one rather than letting the range toggle imply otherwise.
model GscCountryKeyword {
  id         String   @id @default(cuid())
  projectId  String
  country    String
  keywords   Int      @default(0)
  /// Days the count covers, so the UI can say what it is looking at.
  windowDays Int
  syncedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, country])
  @@index([projectId])
}

/// GA4 engagement per landing page.
model Ga4PageMetric {
  id                String   @id @default(cuid())
  projectId         String
  date              DateTime @db.Date
  pagePath          String
  sessions          Int      @default(0)
  users             Int      @default(0)
  pageViews         Int      @default(0)
  engagementRate    Float    @default(0)
  avgEngagementTime Float    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, pagePath])
  @@index([projectId, date])
}

/// A draft article written in Drafter (formerly Content Assistant).
model Article {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  title      String
  keyword    String
  country    String   @default("us")
  /// preparing | draft | in_progress | published
  status     String   @default("preparing")
  /// Markdown/HTML body. Empty until the author or the AI writes something.
  content    String   @default("")
  /// Cached research so the editor never re-crawls on load. Shape: ArticleBrief.
  brief      Json?
  briefError String?

  /// optimize = paste a draft and score it; drafter = recipe → outline → redraft.
  mode String @default("optimize")
  /// outline | draft | proofed — only meaningful in drafter mode.
  phase String @default("")
  /// Raw recipe paste (ingredients + instructions) that the outline is built from.
  recipe String @default("")
  /// Last model output, so redraft can see what the author changed.
  generated String @default("")
  /// Inline notes: [{ id, quote, note }].
  comments Json @default("[]")

  driveFileId  String @default("")
  driveFileUrl String @default("")
  wpDraftId    Int?
  wpEditLink   String @default("")
  wpSyncedAt   DateTime?

  /// Excerpt, slug, SEO title/description, featured image, categories, tags.
  editorial Json @default("{}")
  /// Structured recipe fields, emitted as schema.org Recipe JSON-LD on export.
  /// Distinct from `recipe` above, which is the author's raw paste. Never
  /// generated: the fields are either typed in the recipe panel or split out
  /// of that paste by an ordinary parser, so the structured data never makes a
  /// claim about a real dish that nobody wrote down. Shape: RecipeCard.
  recipeCard Json @default("{}")
  /// Snapshots of outline / redraft / proof / restore — not every keystroke.
  revisions Json @default("[]")
  /// Result of the last WordPress export: template used, sections and steps
  /// populated, links resolved, and anything left needing review. Kept so the
  /// editor can show what happened without re-running the mapper. Shape:
  /// ExportRecord in lib/wordpress/draft-export.ts.
  wpExport Json @default("{}")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  ArticleAsset[]
  jobs    DraftJob[]

  @@index([userId])
  @@index([projectId, updatedAt])
}

/// Image uploaded in Drafter. Bytes stay here until Send to WordPress copies
/// them into the site's media library; wpMediaId/wpUrl then reuse that file.
model ArticleAsset {
  id        String   @id @default(cuid())
  articleId String
  filename  String
  mime      String
  data      Bytes
  alt       String   @default("")
  caption   String   @default("")
  width     Int      @default(0)
  height    Int      @default(0)
  sizeSlug  String   @default("large")
  wpMediaId Int?
  wpUrl     String   @default("")
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// A keyword being rank-tracked for a project, the way KeySearch tracks them.
model TrackedKeyword {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  keyword   String
  /// Search engine domain, e.g. "google.com".
  engine    String   @default("google.com")
  /// Two-letter country for the SERP, e.g. "us".
  country   String   @default("us")
  /// Optional city/region for a localised check.
  location  String?
  /// Optional grouping label, matching KeySearch's Groups.
  groupName String?
  /// Estimated monthly searches, cached so the table need not re-estimate.
  volume    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots RankSnapshot[]

  @@unique([projectId, keyword, engine, country])
  @@index([projectId, updatedAt])
  @@index([userId])
}

/// One measured position for a tracked keyword on a given day.
model RankSnapshot {
  id        String   @id @default(cuid())
  keywordId String
  checkedAt DateTime @default(now())
  /// 1-100, or null when the domain was not found in the results.
  rank      Int?
  /// The ranking URL, when found.
  url       String?
  /// "serp" (measured live) | "search-console" (Google's own average).
  source    String   @default("serp")

  keyword TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, checkedAt])
}

/// One Google identity per user, authorised at sign-in with every scope the
/// app needs. Tokens live here only — projects reference properties, not
/// credentials, so linking a second project never re-prompts.
model GoogleAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  email                 String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?
  /// Space-separated scopes Google actually granted.
  scopes                String    @default("")
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Owner-managed configuration that overrides the deployment environment.
/// Secret values are encrypted with the same key as OAuth tokens.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Grounding facts for GEO Lab drafting. One row per project.
/// The drafting pipeline may not state a number, policy or claim that is not
/// traceable to this record — it falls back to qualitative language instead.
model BusinessFacts {
  id              String   @id @default(cuid())
  projectId       String   @unique
  serviceArea     String   @default("")
  travelPolicy    String   @default("")
  eventTypes      String   @default("")
  guestMin        Int?
  guestMax        Int?
  dietaryHandling String   @default("")
  pricingLogic    String   @default("")
  leadTime        String   @default("")
  consultingScope String   @default("")
  /// 3–5 real past-event details Adam is happy to reference generally.
  pastEvents      String[] @default([])
  /// Explicit claims the generator must never make.
  neverClaim      String[] @default([])
  /// Anchor pages this project can link to: [{ id, label, url }].
  anchorPages     Json     @default("[]")
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// A candidate supporting article produced by moment mapping.
model GeoIdea {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  seed            String
  anchorPageId    String
  title           String
  /// want_to_know | want_to_go | want_to_do | want_to_buy
  moment          String
  /// pricing | problems | not_a_fit | comparison | how_to | local_logistics
  category        String
  rationale       String
  attributes      String[] @default([])
  linkUrl         String   @default("")
  anchorText      String   @default("")
  /// Set when the idea is too close to a published post or a sibling idea.
  redundantWith   String?
  /// idea | drafting | drafted
  status          String   @default("idea")
  draftHtml       String   @default("")
  metaTitle       String   @default("")
  metaDescription String   @default("")
  slug            String   @default("")
  /// Questions lifted from real PAA/GSC signal, with answers.
  faq             Json     @default("[]")
  qaNotes         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

/// One "Draft Article" click.
///
/// Generation is staged across many bounded model calls, and a serverless
/// invocation cannot hold that: the request dies long before the article is
/// written. So the job is a row, not a promise — every worker reads its next
/// move from here, and a browser refresh, a closed tab or a dead function all
/// resume from the same state.
model DraftJob {
  id        String @id @default(cuid())
  userId    String
  projectId String
  articleId String

  /// queued | running | paused | retrying | completed | failed | cancelled
  status String @default("queued")
  /// Name of the stage the runner is on, for the progress list.
  stage  String @default("")

  /// Shared, recoverable state: research, outline, section HTML, metadata.
  /// Persisted so a stage never re-runs work a previous attempt finished.
  state Json @default("{}")

  errorCode    String?
  errorMessage String?

  /// Worker lease. A stale lease is reclaimable; a live one is not.
  workerId       String    @default("")
  claimedAt      DateTime?
  leaseExpiresAt DateTime?

  /// Cooperative cancel: the runner checks this between stages.
  cancelRequested Boolean @default(false)

  /// Cost accounting for the whole job, summed from the stages.
  aiCalls      Int @default(0)
  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// The provider's rolling per-minute allowance, tracked across invocations.
  /// An article needs more tokens than one minute allows, so the job paces
  /// itself here rather than discovering the limit as a 429 mid-section.
  tpmWindowStart  DateTime?
  tpmWindowTokens Int       @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  article Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  stages  DraftJobStage[]

  @@index([articleId, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([userId])
}

/// One bounded step of a DraftJob.
///
/// Unique per (job, name) so a retry that arrives after the original already
/// committed finds the finished row instead of generating the section twice.
model DraftJobStage {
  id         String @id @default(cuid())
  draftJobId String
  name       String
  ordinal    Int

  /// pending | running | completed | failed | skipped
  status  String @default("pending")
  attempt Int    @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  errorCode    String?
  errorMessage String?

  /// Stage result. Small structured data, or a pointer into DraftJob.state
  /// for anything article-sized, so the same HTML is not stored twice.
  output     Json?
  /// Hash of the committed output, so a duplicate commit is detectable.
  outputHash String @default("")

  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  provider     String @default("")
  model        String @default("")
  durationMs   Int    @default(0)

  job DraftJob @relation(fields: [draftJobId], references: [id], onDelete: Cascade)

  @@unique([draftJobId, name])
  @@index([draftJobId, ordinal])
}

/// A saved forecast, kept so it can be checked against reality later.
///
/// The point of storing this is not the chart — it is `assumptions`,
/// `modelVersion` and `dataCutoff`. A forecast whose inputs were not written
/// down cannot be evaluated afterwards: when the actuals come in low, nobody
/// can tell whether the model was wrong, the assumptions were optimistic, or
/// the work in the plan never happened. All three are useful to learn and they
/// are indistinguishable without this row.
model ForesightForecast {
  id        String @id @default(cuid())
  userId    String
  projectId String

  /// Free-text label the author gave it, e.g. "Q1 plan".
  name String @default("")

  /// conservative | expected | aggressive
  scenario String
  /// 3 | 6 | 12
  horizonMonths Int

  /// Engine version, so an old forecast stays reproducible when the maths moves.
  modelVersion      String
  assumptionVersion String
  /// Last day of data behind it. Null when nothing was connected.
  dataCutoff        DateTime?

  /// Every lever, verbatim. Shape: Assumptions in lib/foresight/types.ts.
  assumptions Json @default("{}")
  /// Which sources were available and what kind of data each supplied.
  dataSources Json @default("[]")
  /// Readiness score and checks at the time of the forecast.
  readiness   Json @default("{}")

  /// Headline totals, so a list of forecasts renders without recomputation.
  baselineClicks    Int @default(0)
  forecastClicks    Int @default(0)
  incrementalClicks Int @default(0)
  /// Null unless a backtest had actually been run — never a decorative number.
  confidence        Float?

  /// Month-by-month baseline, expected, and the P10/P90 band.
  months Json @default("[]")
  /// The plan as it stood, so "what did we say we would do" is answerable.
  plan   Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projections ForesightProjection[]
  actuals     ForesightActual[]

  @@index([projectId, createdAt])
  @@index([userId])
}

/// One keyword's forecast inside a saved forecast.
model ForesightProjection {
  id         String @id @default(cuid())
  forecastId String

  keyword String
  page    String @default("")

  /// Null when the keyword did not rank at the time.
  currentPosition  Float?
  targetPosition   Int
  expectedPosition Float

  /// likely | realistic | stretch | too-ambitious
  reachability String
  /// 0–1 share of the gap the model expected to close.
  achievement  Float

  /// Null when no trustworthy demand figure existed. Never a filled-in guess.
  demand       Int?
  /// real | derived | modeled | estimated | unavailable
  demandSource String @default("unavailable")

  currentClicks     Int?
  forecastClicks    Int?
  incrementalClicks Int?

  expectedDays Int?
  confidence   Float @default(0)

  forecast ForesightForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@index([forecastId])
}

/// What actually happened, recorded against what was predicted.
///
/// Written by a comparison run rather than by the forecast itself, so a
/// forecast and its outcome can never be confused for one another.
model ForesightActual {
  id         String   @id @default(cuid())
  forecastId String
  /// First day of the month being compared.
  month      DateTime @db.Date

  predictedClicks Int
  actualClicks    Int
  /// Signed percentage difference, stored so a list view needs no arithmetic.
  variancePercent Float

  recordedAt DateTime @default(now())

  forecast ForesightForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@unique([forecastId, month])
  @@index([forecastId])
}
